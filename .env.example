# === LLM provider: "openai" (direct) or "requesty" (OpenAI-compatible gateway) ===
LLM_PROVIDER=requesty

# Option 1 — direct OpenAI
OPENAI_API_KEY=sk-...

# Option 2 — Requesty router (https://docs.requesty.ai)
REQUESTY_API_KEY=rq-...
REQUESTY_BASE_URL=https://router.requesty.ai/v1

# Model names: bare names work for both providers (auto-prefixed to "openai/<model>" for
# Requesty). To pin another vendor via Requesty use e.g. "anthropic/claude-sonnet-4-20250514".
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# === Pinecone ===
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX=apex-bank-knowledge
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# Set true to use local hybrid search only (no Pinecone network calls)
USE_LOCAL_RETRIEVAL=false

# === LangSmith (mandatory observability) ===
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_...
LANGCHAIN_PROJECT=apex-bank-assistant
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# === App ===
APP_SECRET_KEY=change-me-in-production
API_HOST=0.0.0.0
API_PORT=8000
MCP_BASE_URL=http://localhost:8100
RATE_LIMIT_TOKENS=20
RATE_LIMIT_REFILL_PER_SEC=0.5
HITL_ENABLED=true
LOG_LEVEL=INFO
